# Paramètres Docker Compose. Copier en .env pour les modifier (facultatif : valeurs par défaut).
# Aucun secret réel : identifiants de démonstration locale uniquement.

# Kafka
KAFKA_HOST_PORT=29092
KAFKA_ADVERTISED_HOST=localhost
KAFKA_OBSERVATIONS_TOPIC=maritime.observations.v1
KAFKA_LABELS_TOPIC=maritime.labels.v1
KAFKA_PARTITIONS=3
KAFKA_HEAP_OPTS=-Xms256m -Xmx384m

# Spark : réglé pour Docker Desktop limité à 4 Go. Augmenter si la machine le permet.
SPARK_WORKER_CORES=2
SPARK_WORKER_MEMORY=1400m
SPARK_EXECUTOR_MEMORY=640m
SPARK_DRIVER_MEMORY=768m

# PostgreSQL (base de restitution)
POSTGRES_DB=port_eta
POSTGRES_USER=port_eta
POSTGRES_PASSWORD=port_eta
POSTGRES_HOST_PORT=55432

# Tableau de bord
DASHBOARD_REFRESH_SECONDS=5

# Pour les commandes Python lancées hors Docker, passer --bootstrap-servers localhost:29092.
