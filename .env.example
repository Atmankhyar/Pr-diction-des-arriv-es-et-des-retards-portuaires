# Paramètres Docker Compose uniquement. Aucun secret nécessaire en démonstration locale.
KAFKA_HOST_PORT=29092
KAFKA_ADVERTISED_HOST=localhost
KAFKA_OBSERVATIONS_TOPIC=maritime.observations.v1
KAFKA_LABELS_TOPIC=maritime.labels.v1
KAFKA_PARTITIONS=3
# Pour les commandes Python, passer --bootstrap-servers et --topic si ces valeurs changent.
